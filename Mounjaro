<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rumini Mounjaro Page Prototype</title>
<style>
@font-face { font-family: 'Anton'; src: url(data:font/ttf;base64,) format('truetype'); font-weight: 400; font-display: block; }
@font-face { font-family: 'Plus Jakarta Sans'; src: url(data:font/ttf;base64,) format('truetype'); font-weight: 200 800; font-display: block; }

html{scroll-behavior:smooth}
body{margin:0;background:#FFFFFF}
a{color:#B3001B}a:hover{color:#8B1A1A}
a:focus-visible,button:focus-visible{outline:2px solid #CC1939;outline-offset:3px}

[id] { scroll-margin-top: 84px; }
</style>
</head>
<body>
<div id="dc-root"></div>
<script type="text/x-template" id="dc-template">
<div style="min-height: 100%; background: #FFFFFF; color: #0F172A; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; -webkit-font-smoothing: antialiased">

<!-- Top banner -->
<div style="background: #B3001B; color: #FFFFFF; text-align: center; padding: 9px 16px; font-size: 13px; font-weight: 600; line-height: 1.5">$0 physician assessment · Program fee applies only if you start treatment · Most decisions within 48 hours</div>

<!-- Header -->
<header style="position: sticky; top: 0; z-index: 10; background: rgba(242, 236, 229, 0.96); border-bottom: 1px solid #E5DCD1">
  <div style="max-width: 1200px; margin: 0 auto; padding: 12px clamp(16px, 4vw, 32px); display: flex; align-items: center; justify-content: space-between; gap: 12px">
    <a href="#" aria-label="Rumini home" style="text-decoration: none; display: flex; align-items: center">
      <img src="data:image/webp;base64," alt="Rumini, Your Health Delivered Discreetly" style="height: 46px; width: auto; display: block">
    </a>
    <nav aria-label="On this page" style="display: flex; align-items: center; gap: 4px 22px; flex-wrap: wrap; font-size: 14.5px; font-weight: 600">
      <a href="#eligibility" style="color: #0F172A; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center">Eligibility</a>
      <a href="#program" style="color: #0F172A; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center">Your program</a>
      <a href="#pricing" style="color: #0F172A; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center">Pricing</a>
      <a href="#faq" style="color: #0F172A; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center">FAQ</a>
      <a href="#start" style="display: inline-flex; align-items: center; min-height: 46px; padding: 0 24px; border-radius: 999px; background: #CC1939; color: #FFFFFF; text-decoration: none; font-size: 15px; font-weight: 700; box-shadow: 0 6px 18px rgba(204, 25, 57, 0.28)">Get started</a>
    </nav>
  </div>
</header>

<main>

<!-- Hero -->
<section style="background: radial-gradient(circle at 22% 55%, rgba(204, 25, 57, 0.38), rgba(204, 25, 57, 0) 46%), radial-gradient(circle at 88% 18%, rgba(179, 0, 27, 0.20), rgba(179, 0, 27, 0) 40%), #0F172A; color: #FFFFFF; padding: clamp(48px, 6vw, 84px) 0 clamp(96px, 9vw, 128px)">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); display: flex; flex-wrap: wrap; align-items: center; gap: 48px 64px">

    <div style="flex: 1 1 360px; min-width: 0; display: flex; justify-content: center">
      <img src="data:image/webp;base64," alt="Prescription pen illustration" style="width: 100%; max-width: 480px; height: auto; display: block">
    </div>

    <div id="start" style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px">
      <span style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 999px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.18); font-size: 13px; font-weight: 600; color: #FFFFFF">
        <span style="width: 8px; height: 8px; border-radius: 999px; background: #CC1939"></span>
        100% Canadian Owned · OCP-Accredited Pharmacy
      </span>
      <h1 style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; font-size: clamp(40px, 4.6vw, 64px); line-height: 1.06; letter-spacing: 0.005em; background: linear-gradient(90deg, #FFFFFF 40%, #FFC2CD 60%, #FFFFFF 80%); -webkit-background-clip: text; background-clip: text; color: transparent">How to get your Mounjaro® medication filled online</h1>
      <p style="margin: 0; max-width: 600px; font-size: 18px; line-height: 1.7; font-weight: 500; color: #D5DBE6">Through Rumini, you can get Mounjaro® prescribed by a licensed healthcare practitioner with free delivery to your door.</p>
      <p style="margin: 0; font-size: 14px; color: #AAB4C5">2.5mg, 5mg, 7.5mg, 10mg, 12.5mg, 15mg Tirzepatide Injection</p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 22px">
        <a href="#eligibility" style="display: inline-flex; align-items: center; min-height: 54px; padding: 0 30px; border-radius: 999px; background: #CC1939; color: #FFFFFF; text-decoration: none; font-size: 16px; font-weight: 700; box-shadow: 0 10px 28px rgba(204, 25, 57, 0.40)">Check My Eligibility</a>
        <span style="font-size: 15px; font-weight: 700; color: #F3A3B2">$0 Assessment Fee</span>
      </div>
      <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 10px; text-align: left; margin-top: 4px">
        <sc-for list="{{heroBullets}}" as="b" hint-placeholder-count="4">
          <div style="display: flex; align-items: flex-start; gap: 10px; font-size: 12.5px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.45; color: #FFFFFF">
            <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" style="flex: 0 0 18px"><circle cx="10" cy="10" r="10" fill="#CC1939"></circle><path d="M6 10.4l2.6 2.6L14.2 7.4" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>{{b}}</span>
          </div>
        </sc-for>
      </div>
    </div>
  </div>
</section>

<!-- Stat tiles -->
<section aria-label="Program highlights" style="background: #FFFFFF">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); position: relative; top: -64px; margin-bottom: -40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px">
    <div style="background: #FFFFFF; border-radius: 20px; border: 1px solid #ECECEF; border-bottom: 5px solid #B3001B; box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10); padding: 26px 22px; text-align: center; display: flex; flex-direction: column; gap: 6px">
      <span style="font-family: 'Anton', Impact, sans-serif; font-size: 44px; line-height: 1.05; color: #B3001B">$0</span>
      <span style="font-size: 16px; font-weight: 700; color: #3F3F46">Physician assessment</span>
      <span style="font-size: 13px; line-height: 1.5; color: #52525B">Program fee applies only if you start treatment</span>
    </div>
    <div style="background: #FFFFFF; border-radius: 20px; border: 1px solid #ECECEF; border-bottom: 5px solid #B3001B; box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10); padding: 26px 22px; text-align: center; display: flex; flex-direction: column; gap: 6px">
      <span style="font-family: 'Anton', Impact, sans-serif; font-size: 44px; line-height: 1.05; color: #B3001B">1:1</span>
      <span style="font-size: 16px; font-weight: 700; color: #3F3F46">Pharmacist counselling</span>
      <span style="font-size: 13px; line-height: 1.5; color: #52525B">Every prescription, before your first dose</span>
    </div>
    <div style="background: #FFFFFF; border-radius: 20px; border: 1px solid #ECECEF; border-bottom: 5px solid #B3001B; box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10); padding: 26px 22px; text-align: center; display: flex; flex-direction: column; gap: 6px">
      <span style="font-family: 'Anton', Impact, sans-serif; font-size: 44px; line-height: 1.05; color: #B3001B">Unlimited</span>
      <span style="font-size: 16px; font-weight: 700; color: #3F3F46">Clinical care</span>
      <span style="font-size: 13px; line-height: 1.5; color: #52525B">Consultations with a doctor, included in your program</span>
    </div>
    <div style="background: #FFFFFF; border-radius: 20px; border: 1px solid #ECECEF; border-bottom: 5px solid #B3001B; box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10); padding: 26px 22px; text-align: center; display: flex; flex-direction: column; gap: 6px">
      <span style="font-family: 'Anton', Impact, sans-serif; font-size: 44px; line-height: 1.05; color: #B3001B">100%</span>
      <span style="font-size: 16px; font-weight: 700; color: #3F3F46">Canadian care team</span>
      <span style="font-size: 13px; line-height: 1.5; color: #52525B">Physicians, pharmacists and dedicated support staff</span>
    </div>
  </div>
</section>

<!-- Trust strip -->
<section aria-label="Accreditation and trust" style="background: linear-gradient(120deg, #F2ECE5, #F7E3DD, #F2ECE5); border-top: 1px solid #E5DCD1; border-bottom: 1px solid #E5DCD1">
  <div style="max-width: 1200px; margin: 0 auto; padding: 16px clamp(16px, 4vw, 32px); display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 30px">
    <sc-for list="{{trustItems}}" as="t" hint-placeholder-count="6">
      <span style="display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: #0F172A">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 7" stroke="#B3001B" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        {{t}}
      </span>
    </sc-for>
  </div>
</section>

<!-- Eligibility pre-screen -->
<section id="eligibility" aria-labelledby="elig-h" style="background: #FFFFFF; padding: clamp(64px, 7vw, 96px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 64px">
    <div style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 18px">
      <div style="display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #52525B">
        <span style="display: block; width: 28px; height: 1px; background: #52525B"></span>
        <span>Free pre-screen</span>
      </div>
      <h2 id="elig-h" style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; font-size: clamp(34px, 3.6vw, 50px); line-height: 1.08; color: #0F172A">See if you may be eligible.</h2>
      <div style="width: 56px; height: 4px; border-radius: 2px; background: #B3001B"></div>
      <p style="margin: 0; font-size: 17px; line-height: 1.65; color: #52525B">Enter your height and weight to see where you stand. It takes a few seconds.</p>
      <p style="margin: 0; font-size: 16px; font-weight: 700; color: #0F172A">Prescription weight management is generally for adults with:</p>
      <div style="display: flex; flex-direction: column; gap: 12px">
        <sc-for list="{{criteria}}" as="c" hint-placeholder-count="3">
          <div style="display: flex; align-items: flex-start; gap: 12px; font-size: 16px; line-height: 1.5; color: #1F1F1F">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" style="flex: 0 0 20px; margin-top: 1px"><circle cx="10" cy="10" r="10" fill="#CC1939"></circle><path d="M6 10.4l2.6 2.6L14.2 7.4" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>{{c}}</span>
          </div>
        </sc-for>
      </div>
      <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #52525B">A licensed physician confirms eligibility during your $0 assessment.</p>
    </div>

    <div style="flex: 1 1 500px; min-width: 0">
      <div style="background: #FFFFFF; border: 1px solid #E7E7EA; border-radius: 24px; padding: clamp(22px, 3vw, 34px); box-shadow: 0 20px 48px rgba(15, 23, 42, 0.08); display: flex; flex-direction: column; gap: 20px">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap">
          <h3 style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; font-size: 28px; color: #0F172A">Quick BMI check</h3>
          <div style="display: inline-flex; padding: 4px; gap: 4px; background: #F5F5F6; border-radius: 999px">
            <sc-if value="{{isImperial}}" hint-placeholder-val="{{ true }}">
              <button type="button" aria-pressed="true" style="min-height: 36px; padding: 0 14px; border: 0; border-radius: 999px; background: #0F172A; color: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; cursor: pointer">ft / lb</button>
              <button type="button" aria-pressed="false" onClick="{{setMetric}}" style="min-height: 36px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; color: #3F3F46; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; cursor: pointer">cm / kg</button>
            </sc-if>
            <sc-if value="{{isMetric}}" hint-placeholder-val="{{ false }}">
              <button type="button" aria-pressed="false" onClick="{{setImperial}}" style="min-height: 36px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; color: #3F3F46; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; cursor: pointer">ft / lb</button>
              <button type="button" aria-pressed="true" style="min-height: 36px; padding: 0 14px; border: 0; border-radius: 999px; background: #0F172A; color: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; cursor: pointer">cm / kg</button>
            </sc-if>
          </div>
        </div>

        <sc-if value="{{isImperial}}" hint-placeholder-val="{{ true }}">
          <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px">
            <label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #3F3F46">Height (ft)
              <input type="number" min="0" inputmode="numeric" value="{{ft}}" onChange="{{onFt}}" style="width: 100%; box-sizing: border-box; height: 50px; padding: 0 14px; border: 1px solid #D4D4D8; border-radius: 12px; background: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; color: #0F172A">
            </label>
            <label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #3F3F46">Height (in)
              <input type="number" min="0" inputmode="numeric" value="{{inch}}" onChange="{{onInch}}" style="width: 100%; box-sizing: border-box; height: 50px; padding: 0 14px; border: 1px solid #D4D4D8; border-radius: 12px; background: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; color: #0F172A">
            </label>
            <label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #3F3F46">Weight (lb)
              <input type="number" min="0" inputmode="decimal" value="{{lb}}" onChange="{{onLb}}" style="width: 100%; box-sizing: border-box; height: 50px; padding: 0 14px; border: 1px solid #D4D4D8; border-radius: 12px; background: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; color: #0F172A">
            </label>
          </div>
        </sc-if>
        <sc-if value="{{isMetric}}" hint-placeholder-val="{{ false }}">
          <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px">
            <label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #3F3F46">Height (cm)
              <input type="number" min="0" inputmode="decimal" value="{{cm}}" onChange="{{onCm}}" style="width: 100%; box-sizing: border-box; height: 50px; padding: 0 14px; border: 1px solid #D4D4D8; border-radius: 12px; background: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; color: #0F172A">
            </label>
            <label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: #3F3F46">Weight (kg)
              <input type="number" min="0" inputmode="decimal" value="{{kg}}" onChange="{{onKg}}" style="width: 100%; box-sizing: border-box; height: 50px; padding: 0 14px; border: 1px solid #D4D4D8; border-radius: 12px; background: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; color: #0F172A">
            </label>
          </div>
        </sc-if>

        <div aria-live="polite" style="display: flex; flex-direction: column; gap: 14px; padding: 20px; border-radius: 18px; background: #F5F5F6">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px">
            <div style="display: flex; flex-direction: column; gap: 4px; min-width: 0">
              <span style="font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #52525B">Your BMI</span>
              <span style="font-size: 14px; line-height: 1.45; color: #3F3F46">{{bmiBand}}</span>
            </div>
            <sc-if value="{{hasResult}}" hint-placeholder-val="{{ true }}">
              <span style="font-family: 'Anton', Impact, sans-serif; font-size: 48px; line-height: 1; color: #0F172A">{{bmiText}}</span>
            </sc-if>
          </div>
          <div style="position: relative; padding-top: 6px">
            <div style="display: flex; height: 10px; border-radius: 999px; overflow: hidden" aria-hidden="true">
              <span style="flex: 0 0 40%; background: #E4E4E7"></span>
              <span style="flex: 0 0 10%; background: #E8798D"></span>
              <span style="flex: 1 1 auto; background: #CC1939"></span>
            </div>
            <sc-if value="{{hasResult}}" hint-placeholder-val="{{ true }}">
              <span style="position: absolute; top: 11px; left: {{markerLeft}}; width: 20px; height: 20px; margin: -10px 0 0 -10px; box-sizing: border-box; border-radius: 999px; background: #FFFFFF; border: 3px solid #0F172A" aria-hidden="true"></span>
            </sc-if>
            <div style="position: relative; height: 22px; margin-top: 6px; font-size: 12px; font-weight: 600; color: #52525B" aria-hidden="true">
              <span style="position: absolute; left: 40%; transform: translateX(-50%)">27</span>
              <span style="position: absolute; left: 50%; transform: translateX(-50%)">30</span>
            </div>
          </div>
        </div>

        <sc-if value="{{resLikely}}" hint-placeholder-val="{{ true }}">
          <div style="display: flex; flex-direction: column; gap: 12px">
            <h4 style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; font-size: 26px; line-height: 1.15; color: #0F172A">You may be eligible.</h4>
            <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #3F3F46">A licensed Canadian physician confirms during your $0 assessment.</p>
            <a href="https://rumini.ca/weightloss-questionnaire-single-file.html" style="align-self: flex-start; display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; background: #CC1939; color: #FFFFFF; text-decoration: none; font-size: 16px; font-weight: 700">Start my $0 assessment</a>
          </div>
        </sc-if>
        <sc-if value="{{resMaybe}}" hint-placeholder-val="{{ false }}">
          <div style="display: flex; flex-direction: column; gap: 12px">
            <h4 style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; font-size: 26px; line-height: 1.15; color: #0F172A">You may be eligible with a weight-related condition.</h4>
            <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #3F3F46">Such as high blood pressure, prediabetes or sleep apnea. A licensed physician confirms during your $0 assessment.</p>
            <a href="https://rumini.ca/weightloss-questionnaire-single-file.html" style="align-self: flex-start; display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; background: #CC1939; color: #FFFFFF; text-decoration: none; font-size: 16px; font-weight: 700">Start my $0 assessment</a>
          </div>
        </sc-if>
        <sc-if value="{{resBelow}}" hint-placeholder-val="{{ false }}">
          <div style="display: flex; flex-direction: column; gap: 12px">
            <h4 style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; font-size: 26px; line-height: 1.15; color: #0F172A">Prescription treatment may not be the right fit.</h4>
            <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #3F3F46">It is generally for a BMI of 27 or higher. Our care team can talk through other options with you.</p>
            <a href="tel:289-748-3812" style="align-self: flex-start; display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; border: 1.5px solid #0F172A; color: #0F172A; text-decoration: none; font-size: 16px; font-weight: 700">Call 289-748-3812</a>
          </div>
        </sc-if>

        <p style="margin: 0; padding-top: 16px; border-top: 1px solid #E7E7EA; font-size: 12.5px; line-height: 1.55; color: #52525B">Not a diagnosis. A licensed physician makes the final decision based on your full health history.</p>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section aria-labelledby="how-h" style="background: #F5F5F6; padding: clamp(64px, 7vw, 96px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px)">
    <div style="text-align: center; margin-bottom: 44px">
      <h2 id="how-h" style="margin: 0; font-family: 'Anton', Impact, sans-serif; font-weight: 400; font-size: clamp(32px, 3.4vw, 46px); line-height: 1.1; color: #0F172A">How it works</h2>
      <div style="width: 56px; height: 4px; border-radius: 2px; background: #B3001B; margin: 14px auto 16px"></div>
      <p style="margin: 0 auto; max-width: 560px; font-size: 17px; line-height: 1.65; color: #52525B">From assessment to your door, with a physician and pharmacist at every step.</p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px">
      <div style="background: #FFFFFF; border: 1px solid #E7E7EA; border-radius: 20px; padding: 26px; display: flex; flex-direction: column; gap: 12px">
        <span style="width: 42px; height: 42px; border-radius: 999px; background: #0F172A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-family: 'Anton', Impact, sans-serif; font-size: 19px">1</span>
        <h3 style="margin: 0; font-size: 17.6px; font-weight: 700">Complete your online assessment</h3>
        <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #52525B">A secure questionnaire about your health history and current medications. It's $0.</p>
