      onInch: (e) => this.setState({ inch: e.target.value }),
      onLb: (e) => this.setState({ lb: e.target.value }),
      onCm: (e) => this.setState({ cm: e.target.value }),
      onKg: (e) => this.setState({ kg: e.target.value }),
      hasResult: valid,
      bmiText: valid ? bmi.toFixed(1) : '',
      bmiBand: bmiBand,
      markerLeft: pct.toFixed(1) + '%',
      resLikely: result === 'likely', resMaybe: result === 'maybe', resBelow: result === 'below',
      heroBullets: [
        "Licensed physicians",
        "OCP accredited pharmacy",
        "Free discreet shipping",
        "Direct insurance billing"
      ],
      trustItems: [
        "OCP-accredited pharmacy #311091",
        "LegitScript certified",
        "Licensed Canadian physicians",
        "Ontario pharmacists",
        "100% Canadian owned",
        "Private and secure"
      ],
      benefits: [
        { title: "Physician review", text: "A licensed Canadian physician reviews every assessment. Nothing is approved automatically.", icon: "M5 3v5a5 5 0 0 0 10 0V3M10 13v3a5 5 0 0 0 10 0v-2M20 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4" },
        { title: "Pharmacist counselling", text: "An Ontario pharmacist walks you through your medication and your pen before your first dose.", icon: "M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" },
        { title: "Unlimited clinical care", text: "Consultations with a doctor whenever you need them, included in your program.", icon: "M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z" },
        { title: "Dedicated support team", text: "Real people for questions, refills and delivery, Monday to Saturday.", icon: "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" },
        { title: "Insurance concierge", text: "We bill your insurer directly and help with claims and special authorization paperwork.", icon: "M2 5h20v14H2zM2 10h20" },
        { title: "Refills and renewals", text: "Refill reminders, renewals and follow-ups, handled for you.", icon: "M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5" },
        { title: "Free, discreet delivery", text: "Express shipping in plain packaging, with live tracking once your order ships.", icon: "M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8" },
        { title: "In-person support", text: "See a physician or nurse practitioner in person at [clinic name and location].", icon: "M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5" }
      ],
      programIncludes: [
        "Intake and physician review",
