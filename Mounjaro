<script>

(function () {
  var root = document.getElementById('dc-root');
  var TPL = document.getElementById('dc-template').textContent;
  var fns = [];
  var pending = false;
  window.DCLogic = class {
    constructor(props) { this.props = props || {}; this.state = {}; }
    setState(p) { Object.assign(this.state, typeof p === 'function' ? p(this.state) : p); schedule(); }
  };
  function esc(v) { return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function val(v) {
    if (typeof v === 'function') { fns.push(v); return '__fn' + (fns.length - 1); }
    if (typeof v === 'boolean') return v ? 'true' : 'false';
    if (v === null || v === undefined) return '';
    return esc(v);
  }
  function build(comp) {
    fns = [];
    var vals = comp.renderVals();
    if (window.DC_OPEN_ALL_FAQ && Array.isArray(vals.faqRows)) {
      vals.faqRows.forEach(function (r) { if (r.isQuestion) { r.open = true; r.closed = false; r.exp = 'true'; } });
    }
    var html = TPL.replace(/<sc-for list="\{\{(\w+)\}\}" as="(\w+)"[^>]*>([\s\S]*?)<\/sc-for>/g, function (m, name, v, tpl) {
      return (vals[name] || []).map(function (item) {
        if (item && typeof item === 'object') {
          return tpl.replace(new RegExp('\\{\\{' + v + '\\.(\\w+)\\}\\}', 'g'), function (mm, k) { return val(item[k]); });
        }
        return tpl.split('{{' + v + '}}').join(val(item));
      }).join('');
    });
    html = html.replace(/\{\{(\w+)\}\}/g, function (m, k) { return (k in vals) ? val(vals[k]) : m; });
    var IF = /<sc-if value="([^"]*)"[^>]*>((?:(?!<sc-if)[\s\S])*?)<\/sc-if>/g;
    var prev;
    do {
      prev = html;
      html = html.replace(IF, function (m, c, inner) { return c.trim().toLowerCase() === 'true' ? inner : ''; });
    } while (html !== prev && html.indexOf('<sc-if') !== -1);
    return html.replace(/\son([A-Z]\w*)="__fn(\d+)"/g, function (m, ev, id) { return ' data-on-' + ev.toLowerCase() + '="' + id + '"'; });
  }
  function morph(o, n) {
    if (o.nodeType !== n.nodeType || o.nodeName !== n.nodeName) { o.replaceWith(n.cloneNode(true)); return; }
    if (o.nodeType !== 1) { if (o.nodeValue !== n.nodeValue) o.nodeValue = n.nodeValue; return; }
    Array.from(o.attributes).forEach(function (a) { if (!n.hasAttribute(a.name)) o.removeAttribute(a.name); });
    Array.from(n.attributes).forEach(function (a) { if (o.getAttribute(a.name) !== a.value) o.setAttribute(a.name, a.value); });
    if (o.tagName === 'INPUT' && o !== document.activeElement) {
      var v = n.getAttribute('value') || '';
      if (o.value !== v) o.value = v;
    }
    morphChildren(o, n);
  }
  function morphChildren(op, np) {
    var oc = Array.from(op.childNodes), nc = Array.from(np.childNodes), i;
    for (i = 0; i < nc.length; i++) { if (i < oc.length) morph(oc[i], nc[i]); else op.appendChild(nc[i].cloneNode(true)); }
    for (i = nc.length; i < oc.length; i++) oc[i].remove();
  }
  var comp;
  function render() { var t = document.createElement('div'); t.innerHTML = build(comp); morphChildren(root, t); }
  function schedule() { if (!pending) { pending = true; Promise.resolve().then(function () { pending = false; render(); }); } }
  window.__dcStart = function (Component) {
    comp = new Component({});
    root.innerHTML = build(comp);
    root.addEventListener('click', function (e) {
      var el = e.target.closest('[data-on-click]');
      if (el && root.contains(el)) { var f = fns[+el.getAttribute('data-on-click')]; if (f) f(e); }
    });
    root.addEventListener('input', function (e) {
      var el = e.target.closest('[data-on-change]');
      if (el && root.contains(el)) { var f = fns[+el.getAttribute('data-on-change')]; if (f) f(e); }
    });
  };
})();

</script>
