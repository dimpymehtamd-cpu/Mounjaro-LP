    ];
    const groups = [
      { label: "Getting started", anchor: "faq-start", from: 0, to: 4 },
      { label: "Pricing and insurance", anchor: "faq-pricing", from: 4, to: 8 },
      { label: "Your medication and care", anchor: "faq-care", from: 8, to: 12 },
