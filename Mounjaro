    const order = [0, 1, 2, 3, 4, 5, 6, 8, 7, 9, 10, 12, 11, 13, 14];
    const openFaq = this.state.openFaq;
    const faqRows = [];
    groups.forEach((g, gi) => {
      faqRows.push({ isHeader: true, isQuestion: false, label: g.label, anchor: g.anchor, gap: gi === 0 ? "0px" : "18px" });
      order.slice(g.from, g.to).forEach((i) => {
        const f = faqData[i];
        faqRows.push({
          isHeader: false,
          isQuestion: true,
          q: f.q,
          a: f.a,
          open: openFaq === i,
          closed: openFaq !== i,
          exp: openFaq === i ? "true" : "false",
          toggle: () => this.setState({ openFaq: this.state.openFaq === i ? -1 : i })
        });
      });
    });

    const s = this.state;
    let bmi = null;
    if (s.units === 'imperial') {
      const inches = (parseFloat(s.ft) || 0) * 12 + (parseFloat(s.inch) || 0);
      const lb = parseFloat(s.lb);
      if (inches > 0 && lb > 0) bmi = 703 * lb / (inches * inches);
    } else {
      const mtr = (parseFloat(s.cm) || 0) / 100;
      const kg = parseFloat(s.kg);
      if (mtr > 0 && kg > 0) bmi = kg / (mtr * mtr);
    }
    const valid = bmi !== null && isFinite(bmi) && bmi > 10 && bmi < 90;
    let result = 'none';
    let bmiBand = 'Enter your height and weight.';
    if (valid) {
      if (bmi >= 30) { result = 'likely'; bmiBand = 'A BMI of 30 or more'; }
      else if (bmi >= 27) { result = 'maybe'; bmiBand = 'A BMI of 27 to 29.9'; }
      else { result = 'below'; bmiBand = 'A BMI under 27'; }
    }
    const pct = valid ? Math.min(100, Math.max(0, (bmi - 15) / 30 * 100)) : 0;

    return {
      criteria: [
        "A BMI of 30 or more",
        "Or a BMI of 27 or more with a weight-related condition",
        "Living in Ontario"
